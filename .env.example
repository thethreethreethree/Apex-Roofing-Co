# ─── Local development (these defaults work with zero setup) ───
DATABASE_URI=file:./apex-demo.db
PAYLOAD_SECRET=replace-with-a-long-random-string

# ─── Production — set these as Environment Variables in Vercel ───

# Postgres connection string (Supabase / Neon / Vercel Postgres).
# Any postgres:// URL automatically switches the app from SQLite to Postgres.
# DATABASE_URI=postgresql://user:password@host:5432/dbname

# Public site URL — used by sitemap.xml and robots.txt
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Media storage (Vercel → Storage → Blob). Activates cloud image uploads;
# without it, uploads write to local disk (fine for dev, not for Vercel).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Transactional email (Resend). Without a key, emails are logged to the server
# console instead of being sent.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM_ADDRESS=noreply@your-domain.com
# EMAIL_FROM_NAME=Apex Roofing Co
# OWNER_NOTIFICATION_EMAIL=you@your-domain.com
