# ─── Runs with zero external services: SQLite + local-disk media + console email ───
# No Vercel, no Supabase, no Blob, no Resend, no third-party CMS. One server.
# The custom backend needs no CMS/signing secret — sessions use random DB-stored
# tokens, so DATABASE_URI + NEXT_PUBLIC_SITE_URL are the only variables.

# Single-file SQLite database (libsql). Point this at any writable path.
DATABASE_URI=file:./shaggy.db

# Public site URL — used by sitemap.xml, robots.txt, canonical + OG tags.
# Set this to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
