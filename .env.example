# ─── Runs with zero external services: SQLite + local-disk media + console email ───
# No Vercel, no Supabase, no Blob, no Resend. Everything lives on one server.

# Single-file SQLite database. Point this at any writable path.
DATABASE_URI=file:./shaggy.db

# Long random secret — generate with:  openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL — used by sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.com
